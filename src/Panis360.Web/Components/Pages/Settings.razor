@page "/configuracoes"
@inject ApiClient Api
<SessionGate Roles="@(new[]{"Administrador"})"><h1>Configurações</h1><p class="error">@error</p><p role="status">@message</p>
<section class="card"><h2>Novo usuário</h2><EditForm Model="user" OnValidSubmit="SaveUser" FormName="user"><DataAnnotationsValidator /><ValidationSummary /><div class="grid"><label>Nome<InputText @bind-Value="user.Name" /></label><label>E-mail<InputText @bind-Value="user.Email" type="email" /></label><label>Senha (mínimo 12 caracteres)<span class="password"><InputText @bind-Value="user.Password" type="@(showPassword?"text":"password")" /><button type="button" class="secondary" @onclick="()=>showPassword=!showPassword">@(showPassword?"Ocultar":"Mostrar")</button></span></label><label>Perfil<InputSelect @bind-Value="user.Role"><option>Vendedor</option><option>Estoque</option><option>Financeiro</option><option>Administrador</option></InputSelect></label></div><button disabled="@busy">Cadastrar usuário</button></EditForm></section>
<section class="card"><h2>Condições de pagamento</h2><button @onclick="Load">Carregar condições</button>@foreach(var t in terms){<p>@t.Name: @string.Join(" / ",t.Parts.Select(p=>$"{p.Days} dias — {p.Percent}%"))</p>}<label>Nome<input @bind="termName" /></label><div class="grid"><label>Prazo em dias<input type="number" min="0" @bind="days" /></label><label>Percentual<input type="number" step="0.01" @bind="percent" /></label></div><button class="secondary" @onclick="AddPart">Adicionar parcela</button><p>@string.Join(" / ",parts.Select(p=>$"{p.Days}d: {p.Percent}%"))</p><button @onclick="SaveTerm" disabled="@busy">Salvar condição</button><button class="secondary" @onclick="()=>parts.Clear()">Limpar parcelas</button></section></SessionGate>
@code{UserInput user=new();List<TermDto>terms=[];List<TermPartDto>parts=[];string termName="",error="",message="";int days;decimal percent=100;bool busy,showPassword;async Task SaveUser(){busy=true;try{await Api.Post("/api/users",user);user=new();message="Usuário cadastrado.";error="";}catch(Exception e){error=e.Message;}finally{busy=false;}}async Task Load(){try{terms=await Api.Get<List<TermDto>>("/api/terms");error="";}catch(Exception e){error=e.Message;}}void AddPart()=>parts.Add(new(days,percent));async Task SaveTerm(){busy=true;try{await Api.Post("/api/terms",new TermInput(termName,parts.ToList()));parts.Clear();termName="";message="Condição cadastrada.";await Load();}catch(Exception e){error=e.Message;}finally{busy=false;}}}
