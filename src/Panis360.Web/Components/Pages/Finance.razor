@page "/financeiro"
@inject ApiClient Api
<SessionGate Roles="@(new[]{"Administrador","Financeiro","Vendedor"})"><h1>Contas a receber</h1><button @onclick="Load">Carregar / atualizar</button><p class="error">@error</p><p>Saldo total: R$ @titles.Sum(t=>t.Balance).ToString("N2")</p>
<table><thead><tr><th>Cliente</th><th>Parcela</th><th>Vencimento</th><th>Valor</th><th>Recebido</th><th>Saldo</th><th>Forma</th><th>Ação</th></tr></thead><tbody>@foreach(var t in titles){<tr><td>@t.CustomerName</td><td>@t.Number</td><td>@t.DueDate.ToString("dd/MM/yyyy")</td><td>@t.Amount.ToString("N2")</td><td>@t.Paid.ToString("N2")</td><td>@t.Balance.ToString("N2")</td><td>@t.PaymentMethod</td><td>@if(t.Balance>0 && Api.HasRole("Administrador","Financeiro")){<button @onclick="()=>Select(t)">Receber</button>}</td></tr>}</tbody></table>
@if(selected!=null){<section class="card"><h2>Receber de @selected.CustomerName</h2><label>Valor<input type="number" min="0.01" step="0.01" @bind="amount" /></label><button @onclick="Receive" disabled="@busy">Confirmar recebimento</button><button class="secondary" @onclick="()=>selected=null">Fechar</button></section>}
<p>Forma de pagamento é um registro interno. Este módulo não emite boletos nem confirma PIX no banco.</p></SessionGate>
@code{List<ReceivableDto>titles=[];ReceivableDto?selected;decimal amount;Guid requestId;bool busy;string error="";async Task Load(){try{titles=await Api.Get<List<ReceivableDto>>("/api/receivables");error="";}catch(Exception e){error=e.Message;}}void Select(ReceivableDto t){selected=t;amount=t.Balance;requestId=Guid.NewGuid();}async Task Receive(){if(selected is null)return;busy=true;try{await Api.Post($"/api/receivables/{selected.Id}/receive",new ReceiptInput(requestId,amount));selected=null;await Load();}catch(Exception e){error=e.Message;}finally{busy=false;}}}
