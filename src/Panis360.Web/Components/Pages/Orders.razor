@page "/pedidos"
@inject ApiClient Api
<SessionGate><h1>Pedidos e cortes</h1><button @onclick="Load">Carregar / atualizar</button><p class="error" role="alert">@error</p><p role="status">@message</p>
@if(Api.HasRole("Administrador","Vendedor")){<section class="card"><h2>Novo pedido</h2><div class="grid"><label>Cliente<select @bind="customerId"><option value="@Guid.Empty">Selecione</option>@foreach(var c in customers){<option value="@c.Id">@c.Name</option>}</select></label><label>Condição<select @bind="termId"><option value="@Guid.Empty">Selecione</option>@foreach(var t in terms){<option value="@t.Id">@t.Name</option>}</select></label><label>Forma<select @bind="method"><option>Boleto</option><option>PIX</option><option>Dinheiro</option><option>Cartão</option></select></label></div>
<div class="grid"><label>Produto<select @bind="productId"><option value="@Guid.Empty">Selecione</option>@foreach(var p in products){<option value="@p.Id">@p.Name · R$ @p.Price.ToString("N2")</option>}</select></label><label>Quantidade<input type="number" step="0.001" @bind="quantity" /></label></div><button class="secondary" @onclick="Add">Adicionar item</button>
@foreach(var l in lines){<p>@products.First(p=>p.Id==l.ProductId).Name · @l.Quantity <button class="secondary" @onclick="()=>Remove(l)">Remover</button></p>}
<p>Total estimado: R$ @Estimate.ToString("N2")</p><button disabled="@busy" @onclick="Save">Enviar pedido</button></section>}
@foreach(var o in orders){<section class="card"><h2>@o.CustomerName <span class="badge">@o.Status</span></h2><small>@o.Id · @o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small><table><thead><tr><th>Produto</th><th>Pedido</th><th>Atendido</th><th>Preço</th></tr></thead><tbody>@foreach(var i in o.Items){<tr><td>@i.ProductName</td><td>@i.Requested</td><td>@i.Accepted</td><td>@i.UnitPrice.ToString("N2")</td></tr>}</tbody></table><p>Total: R$ @o.Total.ToString("N2") · @o.CutReason</p>
@if(o.Status=="Recebido" && Api.HasRole("Administrador","Estoque")){<button disabled="@busy" @onclick="()=>Edit(o)">Ajustar corte</button><button disabled="@busy" @onclick="()=>Sell(o)">Confirmar venda</button>}
@if(o.Status=="Recebido" && Api.HasRole("Administrador")){<button disabled="@busy" class="secondary" @onclick="()=>Cancel(o)">Cancelar pedido</button>}
</section>}
@if(editing is not null){<section class="card"><h2>Corte de @editing.CustomerName</h2>@foreach(var line in cuts){<label>@line.Name — solicitado: @line.Requested<input type="number" min="0" max="@line.Requested" step="0.001" @bind="line.Accepted" /></label>}<label>Motivo<input @bind="reason" /></label><button disabled="@busy" @onclick="ApplyCut">Salvar corte</button><button class="secondary" @onclick="()=>editing=null">Fechar</button></section>}
</SessionGate>
@code {
 List<CustomerDto>customers=[];List<ProductDto>products=[];List<TermDto>terms=[];List<OrderDto>orders=[];List<OrderLineInput>lines=[];
 Guid customerId,termId,productId,requestId=Guid.NewGuid();decimal quantity=1;string method="Boleto",error="",message="",reason="";bool busy;OrderDto?editing;List<CutEdit>cuts=[];
 decimal Estimate=>lines.Sum(l=>Math.Round(products.First(p=>p.Id==l.ProductId).Price*l.Quantity,2,MidpointRounding.AwayFromZero));
 async Task Load(){try{products=await Api.Get<List<ProductDto>>("/api/products");terms=await Api.Get<List<TermDto>>("/api/terms");orders=await Api.Get<List<OrderDto>>("/api/orders");if(Api.HasRole("Administrador","Vendedor"))customers=await Api.Get<List<CustomerDto>>("/api/customers");error="";}catch(Exception e){error=e.Message;}}
 void Add(){if(productId==Guid.Empty||quantity<=0){error="Selecione produto e quantidade positiva.";return;}if(lines.Any(x=>x.ProductId==productId)){error="Produto já adicionado.";return;}lines.Add(new(productId,quantity));requestId=Guid.NewGuid();}
 void Remove(OrderLineInput l){lines.Remove(l);requestId=Guid.NewGuid();}
 async Task Save(){busy=true;try{await Api.Post("/api/orders",new OrderInput{ClientRequestId=requestId,CustomerId=customerId,PaymentTermId=termId,PaymentMethod=method,Items=lines.ToList()});lines=[];requestId=Guid.NewGuid();message="Pedido recebido. Preços confirmados pelo servidor.";await Load();}catch(Exception e){error=e.Message;}finally{busy=false;}}
 void Edit(OrderDto o){editing=o;reason=o.CutReason;cuts=o.Items.Select(i=>new CutEdit{Id=i.Id,Name=i.ProductName,Requested=i.Requested,Accepted=i.Accepted}).ToList();}
 async Task ApplyCut(){if(editing is null)return;busy=true;try{await Api.Put($"/api/orders/{editing.Id}/cut",new CutInput(reason,cuts.Select(c=>new CutLine(c.Id,c.Accepted)).ToList()));editing=null;await Load();}catch(Exception e){error=e.Message;}finally{busy=false;}}
 async Task Sell(OrderDto o){busy=true;try{await Api.Post($"/api/orders/{o.Id}/sell",new{});message="Venda confirmada, estoque baixado e parcelas geradas.";await Load();}catch(Exception e){error=e.Message;}finally{busy=false;}}
 async Task Cancel(OrderDto o){busy=true;try{await Api.Post($"/api/orders/{o.Id}/cancel",new{});await Load();}catch(Exception e){error=e.Message;}finally{busy=false;}}
 class CutEdit{public Guid Id{get;set;}public string Name{get;set;}="";public decimal Requested{get;set;}public decimal Accepted{get;set;}}
}
