@page "/produtos"
@inject ApiClient Api
<SessionGate><h1>Produtos</h1><button @onclick="Load">Carregar / atualizar</button><p class="error">@error</p>
@if(Api.HasRole("Administrador")){<section class="card"><h2>Novo produto</h2><EditForm Model="form" OnValidSubmit="Save" FormName="product"><DataAnnotationsValidator /><ValidationSummary /><div class="grid"><label>Nome<InputText @bind-Value="form.Name" /></label><label>Grupo<InputText @bind-Value="form.Group" /></label><label>Unidade<InputSelect @bind-Value="form.Unit"><option>UN</option><option>KG</option><option>L</option></InputSelect></label><label>Preço<InputNumber @bind-Value="form.Price" /></label></div><button disabled="@busy">Salvar produto</button></EditForm></section>}
<table><thead><tr><th>Produto</th><th>Grupo</th><th>Unidade</th><th>Preço</th><th>Estoque válido</th></tr></thead><tbody>@foreach(var p in products){<tr><td>@p.Name</td><td>@p.Group</td><td>@p.Unit</td><td>@p.Price.ToString("N2")</td><td>@p.Available</td></tr>}</tbody></table></SessionGate>
@code{ProductInput form=new();List<ProductDto>products=[];string error="";bool busy;async Task Load(){try{products=await Api.Get<List<ProductDto>>("/api/products");error="";}catch(Exception e){error=e.Message;}}async Task Save(){busy=true;try{await Api.Post("/api/products",form);form=new();await Load();}catch(Exception e){error=e.Message;}finally{busy=false;}}}
