@page "/estoque"
@inject ApiClient Api
<SessionGate Roles="@(new[]{"Administrador","Estoque"})"><h1>Estoque por lote</h1><p>A venda baixa primeiro os lotes com vencimento mais próximo. Lotes vencidos não são utilizados.</p><button @onclick="Load">Carregar / atualizar</button><p class="error">@error</p><p>@message</p>
<section class="card"><h2>Entrada de lote</h2><div class="grid"><label>Produto<select @bind="productId"><option value="@Guid.Empty">Selecione</option>@foreach(var p in products){<option value="@p.Id">@p.Name</option>}</select></label><label>Código do lote<input @bind="code" /></label><label>Validade<input type="date" @bind="expiry" /></label><label>Quantidade<input type="number" step="0.001" @bind="quantity" /></label></div><button @onclick="Save" disabled="@busy">Registrar entrada</button></section>
@if(editing is not null){<section class="card"><h2>Ajustar lote · @editing.ProductName</h2><p>Saldo atual: @editing.Quantity @editing.Unit. A diferença no saldo é registrada como movimentação de ajuste, com o motivo informado.</p><div class="grid"><label>Código do lote<input @bind="editCode" /></label><label>Validade<input type="date" @bind="editExpiry" /></label><label>Novo saldo (@editing.Unit)<input type="number" step="@(editing.Unit=="UN"?"1":"0.001")" min="0" @bind="editQuantity" /></label><label>Motivo do ajuste<input @bind="editReason" placeholder="Ex.: contagem física, perda, avaria" /></label></div><button @onclick="SaveEdit" disabled="@busy">Salvar ajuste</button><button class="secondary" @onclick="()=>editing=null">Cancelar</button></section>}
<table><thead><tr><th>Produto</th><th>Lote</th><th>Validade</th><th>Saldo</th><th></th></tr></thead><tbody>@foreach(var l in lots){<tr><td>@l.ProductName</td><td>@l.Code</td><td>@l.ExpiresOn.ToString("dd/MM/yyyy")</td><td>@l.Quantity @l.Unit</td><td><button class="secondary" @onclick="()=>Edit(l)">Editar</button><button class="secondary" @onclick="()=>History(l)">Histórico</button></td></tr>}</tbody></table>
@if(historyLot is not null){<section class="card"><h2>Histórico · @historyLot.ProductName · lote @historyLot.Code</h2><p>Mais recentes primeiro. Saldo após cada movimentação, em @historyLot.Unit.</p><table><thead><tr><th>Data</th><th>Movimentação</th><th>Saldo após</th><th>Motivo</th><th>Usuário</th></tr></thead><tbody>@foreach(var m in moves){<tr><td>@m.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(m.Quantity>0?"+":"")@m.Quantity</td><td>@m.Balance</td><td>@m.Reason</td><td>@m.User</td></tr>}</tbody></table><button class="secondary" @onclick="()=>historyLot=null">Fechar histórico</button></section>}</SessionGate>
@code {Guid productId;string code="",error="",message="";DateTime expiry=DateTime.Today.AddMonths(1);decimal quantity=1;bool busy;List<ProductDto>products=[];List<LotDto>lots=[];
 LotDto? editing,historyLot;string editCode="",editReason="";DateTime editExpiry;decimal editQuantity;List<MovementDto>moves=[];
 async Task History(LotDto l){try{moves=await Api.Get<List<MovementDto>>($"/api/lots/{l.Id}/movements");historyLot=l;error="";}catch(Exception e){error=e.Message;}}
 async Task Load(){try{products=await Api.Get<List<ProductDto>>("/api/products");lots=await Api.Get<List<LotDto>>("/api/lots");error="";}catch(Exception e){error=e.Message;}}
 async Task Save(){busy=true;message="";try{await Api.Post("/api/lots",new LotInput(productId,code,DateOnly.FromDateTime(expiry),quantity));code="";await Load();}catch(Exception e){error=e.Message;}finally{busy=false;}}
 void Edit(LotDto l){editing=l;editCode=l.Code;editExpiry=l.ExpiresOn.ToDateTime(TimeOnly.MinValue);editQuantity=l.Quantity;editReason="";error="";message="";}
 async Task SaveEdit(){if(editing is null)return;busy=true;try{await Api.Put($"/api/lots/{editing.Id}",new LotEditInput(editCode,DateOnly.FromDateTime(editExpiry),editQuantity,editReason,editing.Revision));message=$"Lote {editCode} ajustado.";var id=editing.Id;editing=null;await Load();if(historyLot?.Id==id)await History(lots.First(x=>x.Id==id));}catch(Exception e){error=e.Message;}finally{busy=false;}}}
